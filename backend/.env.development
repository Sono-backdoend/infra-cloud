# DB_ENGINE controla qual banco o backend usa:
#   - "dynamodb" (padrão): usado em produção (AWS Lambda + DynamoDB)
#   - "mongo": usa o MongoDB local do docker-compose (banco-de-dados/)
DB_ENGINE=mongo

# Credenciais devem bater com o serviço "mongo" em docker-compose.yaml
MONGO_URI=mongodb://root:rootpassword@localhost:27017/?authSource=admin
MONGO_DB=todo-app
MONGO_COLLECTION=todos

PORT=5000
APP_ENV=development

API_HORAS_TOKEN=chk_live_8ac9fab8e12e183c845411d8c098688c7a3a4958
API_HORAS_URL=https://horas.zibikoski.com.br/api/v1/